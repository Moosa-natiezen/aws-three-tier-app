# Copy to .env (git-ignored) and fill in. NEVER commit real values.

# --- Terraform injects these into Lambda env at `terraform apply` time ------
# (declared in terraform/variables.tf as sensitive; passed as TF_VAR_* or a
#  git-ignored terraform.tfvars)
TF_VAR_neon_database_url=postgres://USER:PASS@ep-xxxx-pooler.eu-west-1.aws.neon.tech/neondb?sslmode=require
TF_VAR_better_auth_secret=generate-a-long-random-string
TF_VAR_better_auth_url=https://app.example.com

# --- Lambda runtime env (set by Terraform from the TF_VARs above) ----------
NEON_DATABASE_URL=postgres://USER:PASS@ep-xxxx-pooler.eu-west-1.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=https://app.example.com
